{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.runningcoachapp.twnqmf",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Suivi GPS de tes courses en temps réel",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Suit ta course même écran verrouillé",
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.runningcoachapp.twnqmf",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Importer tes courses et ta fréquence cardiaque Apple Watch",
          "NSHealthUpdateUsageDescription": "PACE n'écrit aucune donnée de santé",
          "background": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Suivi GPS de tes courses en temps réel",
          "locationAlwaysAndWhenInUsePermission": "Suit ta course même écran verrouillé",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-audio",
      "@kingstinct/react-native-healthkit"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
